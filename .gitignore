# Gradle
# 前面这个斜杠很重要：只忽略仓库根目录下的 build，否则会把
# src/main/java/com/example/blueprint/build 这种同名源码包一起忽略掉，
# 结果本地能编译、CI 上却缺文件。
/.gradle/
/build/
/out/
/bin/

# Forge 运行目录
/run/
/run-data/
/run-server/
/logs/
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/
*.launch

# 临时诊断目录：核对第三方 API 时下载的 jar，不该进仓库
/.ae2check/

# 提交信息临时文件（Windows 下 cmd 会吞引号，只能走文件）
/commit_msg.txt

# AI 助手的工作目录：提交信息临时文件、随手记的草稿都在这里。
# 它们描述的是"某一次改动的过程"，不是这个模组的源码，所以不进仓库
# （目录本身该留着——下次提交还要往里写临时文件）。
/.codebuddy/

# publishing 的目标目录（build.gradle 里 maven { url "file://.../$mcmodsrepo" }）：
# 那是给本地测试用的产物，不是源码
/mcmodsrepo/

# 系统
.DS_Store
Thumbs.db
